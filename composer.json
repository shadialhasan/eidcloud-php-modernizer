{
  "name": "eidcloud/php-modernizer",
  "description": "Automated legacy PHP code modernizer upgrading PHP 5/7 procedural patterns and mysql_* to PDO and PHP 8.4+",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Eng. MHD. Shadi AL-Hasan",
      "role": "Author & Maintainer"
    }
  ],
  "require": {
    "php": ">=8.2.0"
  },
  "autoload": {
    "psr-4": {
      "EidCloud\\PhpModernizer\\": "src/"
    }
  },
  "bin": [
    "bin/eidcloud-modernize"
  ],
  "scripts": {
    "test": "php tests/run_tests.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
